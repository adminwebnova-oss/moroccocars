# ==============================================================
# MOROCCO CARS — CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# ==============================================================

# --- ASSISTANT IA & SERVICES GOOGLE ---
# GEMINI_API_KEY: Clé API requise pour le conseiller IA intelligent.
# Obtenue sur https://aistudio.google.com/
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL publique de votre hébergement (ex: https://moroccocars.ma).
# Utilisée pour les liens d'accès, métadonnées OpenGraph et webhooks.
APP_URL="http://localhost:3000"

# --- ADMINISTRATION & SÉCURITÉ ---
# ADMIN_EMAIL: Adresse email du compte Super Administrateur de l'agence.
ADMIN_EMAIL="admin@moroccocars.ma"

# ADMIN_PASSWORD: Mot de passe initial lors du premier déploiement de la base.
# Remplacez cette valeur par un mot de passe fort sur votre hébergement.
ADMIN_PASSWORD="admin_morocco_cars_2026"

# JWT_SECRET: Clé secrète cryptographique utilisée pour signer et vérifier les sessions admin JWT.
# Générez une chaîne aléatoire d'au moins 32 caractères pour la production.
JWT_SECRET="morocco_cars_secure_jwt_secret_token_key_2026"

# --- BASE DE DONNÉES & SERVEUR ---
# DATABASE_DIR: Dossier sur le disque où est stocké le fichier de base de données morocco_cars.json
# et les sauvegardes automatiques. (Valeur par défaut : ./data)
DATABASE_DIR="./data"

# PORT: Port réseau d'écoute du serveur Node.js / Express (défaut : 3000)
PORT="3000"

# NODE_ENV: Environnement d'exécution ('development' ou 'production')
NODE_ENV="production"
